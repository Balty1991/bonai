{
  "name": "buget-familie",
  "version": "2.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:pages": "GITHUB_PAGES=true vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "cap:sync": "vite build && cap sync android",
    "cap:android": "pnpm run cap:sync && cap open android",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "lighthouse": "pnpm build && node scripts/lighthouse.mjs",
    "format": "prettier --write .",
    "test:layout": "node e2e/layout.e2e.mjs",
    "test:flows": "node e2e/flows.e2e.mjs",
    "test:split": "node e2e/split-receipt.e2e.mjs",
    "test:sync": "firebase emulators:exec --config firebase.e2e.json --only firestore,auth --project buget-familie-a6a0d \"node e2e/sync.e2e.mjs\"",
    "test:sync:current": "E2E_RULES=auth firebase emulators:exec --config firebase.e2e.auth.json --only firestore,auth --project buget-familie-a6a0d \"node e2e/sync.e2e.mjs\""
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "8.2.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "@capgo/native-purchases": "^8.8.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/react": "^10.76.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.22.3",
    "firebase": "^12.18.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.453.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^4.2.4",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^4.9.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "chrome-launcher": "^1.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.31.0",
    "globals": "^17.12.0",
    "lighthouse": "^12.8.2",
    "playwright-core": "^1.63.0",
    "pnpm": "^10.15.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "tailwindcss>nanoid": "3.3.7",
      "proxy-addr": "^2.0.8",
      "dompurify": "^3.4.16",
      "@grpc/grpc-js@<1.13.6": "^1.14.5"
    }
  }
